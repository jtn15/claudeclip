<div class="waitlist">
  <div class="waitlist-inner">
    {% render 'logo-lockup', class: 'logo-hero' %}
    <h1>{{ settings.tagline }}</h1>
    <p class="muted">{{ settings.password_message }}</p>
    <div class="waitlist-form">
      {% render 'signup-form', form_id: 'waitlist', tag: settings.password_signup_tag, button: 'Notify me', success: 'You are on the list. We will email you when the store opens.' %}
    </div>
    <details class="owner-login">
      <summary class="label">Enter using password</summary>
      <div>
        {%- form 'storefront_password' -%}
          {%- if form.errors -%}<div class="form-msg form-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <label class="label" for="storefront-password">Password</label>
          <input id="storefront-password" type="password" name="password" autocomplete="current-password" required>
          <button class="btn" type="submit">Enter</button>
        {%- endform -%}
      </div>
    </details>
  </div>
</div>
{%- if settings.show_established and settings.established != blank -%}
  <footer class="site-footer site-footer-slim">
    <div class="wrap footer-base footer-base-center"><p>Est. {{ settings.established | escape }}</p></div>
  </footer>
{%- endif -%}

{% schema %}
{
  "name": "Waitlist page"
}
{% endschema %}

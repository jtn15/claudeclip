<section>
  <div class="wrap">
    {%- if section.settings.heading != blank -%}<div class="section-head"><h2>{{ section.settings.heading }}</h2></div>{%- endif -%}
    <div class="grid">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c != blank -%}
          <div class="card" {{ block.shopify_attributes }}>
            <a class="card-link" href="{{ c.url }}">
              <div class="card-media">{% render 'media-or-placeholder', media: c.featured_image, alt: c.title %}</div>
              <div class="card-meta"><h3 class="card-name">{{ c.title | escape }}</h3></div>
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by category",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Shop by category" }]
}
{% endschema %}

{%- if section.settings.text != blank -%}
  <div class="announce label">
    <p>
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {%- else -%}
        {{ section.settings.text }}
      {%- endif -%}
    </p>
  </div>
{%- elsif request.design_mode -%}
  <div class="announce label"><p>Announcement bar (empty: add text in this section to show it)</p></div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "info": "Leave blank to hide the bar." },
    { "type": "url", "id": "link", "label": "Link", "info": "Optional. Makes the whole line clickable." }
  ]
}
{% endschema %}

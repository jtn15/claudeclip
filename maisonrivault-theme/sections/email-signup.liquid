{%- comment -%}Dark email signup band. Section id keeps multiple copies from clashing.{%- endcomment -%}
<section class="teaser" id="signup-{{ section.id }}">
  <div class="wrap teaser-grid">
    <div class="teaser-copy">
      {%- if section.settings.eyebrow != blank -%}<p class="label">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="teaser-text">{{ section.settings.text }}</p>{%- endif -%}
      {% render 'signup-form', form_id: section.id, tag: section.settings.tag, button: section.settings.button, success: section.settings.success %}
    </div>
    <div class="teaser-art" aria-hidden="true">
      {%- if section.settings.image != blank -%}
        {% render 'media-or-placeholder', media: section.settings.image, alt: '', sizes: '(min-width: 52rem) 35vw, 100vw', widths: '450, 700, 900' %}
      {%- else -%}
        {% render 'logo-monogram', class: 'teaser-mono' %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Email signup",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the list" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New pieces and restocks, straight to your inbox." },
    { "type": "text", "id": "button", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Thank you. You are on the list." },
    { "type": "text", "id": "tag", "label": "Extra customer tag", "info": "Optional. Added alongside the newsletter tag so you can segment this list." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Leave empty to show the monogram." }
  ],
  "presets": [{ "name": "Email signup" }]
}
{% endschema %}

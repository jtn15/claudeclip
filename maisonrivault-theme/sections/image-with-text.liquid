<section class="image-text{% if section.settings.image_right %} image-text-reverse{% endif %}">
  <div class="wrap image-text-grid">
    <div class="image-text-art">
      {% render 'media-or-placeholder', media: section.settings.image, alt: section.settings.image_alt, caption: 'Image' %}
    </div>
    <div class="image-text-copy">
      {%- if section.settings.eyebrow != blank -%}<p class="label muted">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="prose">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
        <p><a class="btn" href="{{ section.settings.button_url }}">{{ section.settings.button_label }}</a></p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image description", "info": "For screen readers, when the image has no alt text of its own." },
    { "type": "checkbox", "id": "image_right", "label": "Image on the right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to layer" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe what makes the pieces work together.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}

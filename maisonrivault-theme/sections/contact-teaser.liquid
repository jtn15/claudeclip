<section class="contact-teaser">
  <div class="wrap contact-teaser-inner">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="label muted">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <a class="contact-teaser-form" href="{{ section.settings.link | default: pages.contact.url | default: '/pages/contact' }}" aria-label="{{ section.settings.button }}">
      <span class="contact-teaser-field">Your email</span>
      <span class="contact-teaser-field contact-teaser-msg">How can we help?</span>
      <span class="btn">{{ section.settings.button }}</span>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Contact teaser",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions? We are here." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Sizing, an order, or a return. Send us a message and we will reply by email." },
    { "type": "text", "id": "button", "label": "Button label", "default": "Contact us" },
    { "type": "url", "id": "link", "label": "Link", "info": "Leave blank to use the page with the handle contact." }
  ],
  "presets": [{ "name": "Contact teaser" }]
}
{% endschema %}

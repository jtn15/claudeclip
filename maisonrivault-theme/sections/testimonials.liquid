{%- comment -%}Only add real customer quotes you have permission to use. Do not invent reviews.{%- endcomment -%}
<section class="testimonials">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}<div class="section-head"><h2>{{ section.settings.heading }}</h2></div>{%- endif -%}
    <div class="quotes">
      {%- for block in section.blocks -%}
        <figure class="quote" {{ block.shopify_attributes }}>
          <blockquote><p>{{ block.settings.quote }}</p></blockquote>
          {%- if block.settings.name != blank -%}<figcaption class="label muted">{{ block.settings.name }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer quotes",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name", "info": "First name and initial is plenty." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Customer quotes" }]
}
{% endschema %}

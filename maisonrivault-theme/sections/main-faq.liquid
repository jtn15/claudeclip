<section class="page-head"><div class="col"><h1>{{ page.title | escape }}</h1></div></section>
<section class="page-body">
  <div class="col">
    {%- for block in section.blocks -%}
      {%- assign source = block.settings.source | default: 'custom' -%}
      {%- if block.settings.answer != blank or source != 'custom' or request.design_mode -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div>
            {%- if source == 'returns' -%}
              <p>{% render 'policy-text', part: 'returns_full' %}</p>
              {{ block.settings.answer }}
            {%- elsif source == 'shipping' -%}
              <p>{% render 'policy-text', part: 'shipping' %}{% if settings.duties_note != blank %} {% render 'policy-text', part: 'duties' %}{% endif %}</p>
              {{ block.settings.answer }}
            {%- elsif block.settings.answer != blank -%}{{ block.settings.answer }}{%- else -%}{%- assign missing_label = 'answer to: ' | append: block.settings.question -%}<p>{% render 'todo', label: missing_label %}</p>{%- endif -%}
          </div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        {
          "type": "select", "id": "source", "label": "Answer from", "default": "custom",
          "options": [
            { "value": "custom", "label": "Text below" },
            { "value": "returns", "label": "Return wording (theme settings > Returns), then text below" },
            { "value": "shipping", "label": "Shipping wording (theme settings > Availability and Shipping), then text below" }
          ]
        },
        { "type": "richtext", "id": "answer", "label": "Answer", "info": "Questions without an answer are hidden from customers." }
      ]
    }
  ]
}
{% endschema %}

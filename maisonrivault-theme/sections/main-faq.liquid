{%- comment -%}
  An answer can include [returns] or [shipping]. They are replaced with the shared wording from theme settings
  (snippets/policy-text.liquid), so the FAQ always matches the product page, cart and footer.
{%- endcomment -%}
{%- capture faq_returns -%}{% render 'policy-text', part: 'returns_full' %}{%- endcapture -%}
{%- capture faq_shipping -%}{% render 'policy-text', part: 'shipping' %}{% if settings.duties_note != blank %} {% render 'policy-text', part: 'duties' %}{% endif %}{%- endcapture -%}
<section class="page-head"><div class="col"><h1>{{ page.title | escape }}</h1></div></section>
<section class="page-body">
  <div class="col">
    {%- for block in section.blocks -%}
      {%- if block.settings.answer != blank or request.design_mode -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div>
            {%- if block.settings.answer != blank -%}{{ block.settings.answer | replace: '[returns]', faq_returns | replace: '[shipping]', faq_shipping }}{%- else -%}{%- assign missing_label = 'answer to: ' | append: block.settings.question -%}<p>{% render 'todo', label: missing_label %}</p>{%- endif -%}
          </div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "info": "Questions without an answer are hidden from customers." }
      ]
    }
  ]
}
{% endschema %}

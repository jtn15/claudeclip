<section class="video-section">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}<div class="section-head"><h2>{{ section.settings.heading }}</h2></div>{%- endif -%}
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: image_size: '1100x', controls: true, loop: false, muted: false, class: 'video-frame' }}
    {%- elsif section.settings.video_url != blank -%}
      <div class="video-embed">{{ section.settings.video_url | external_video_tag }}</div>
    {%- elsif request.design_mode -%}
      <p class="muted">Upload a video or paste a YouTube / Vimeo link.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Video",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "video", "id": "video", "label": "Shopify-hosted video" },
    { "type": "video_url", "id": "video_url", "label": "Or YouTube / Vimeo link", "accept": ["youtube", "vimeo"] }
  ],
  "presets": [{ "name": "Video" }]
}
{% endschema %}

<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <title>{{ shop.name }}</title>
    {%- assign meta_description = shop.description | default: settings.tagline -%}
    <meta name="description" content="{{ meta_description | strip_html | escape }}">
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:title" content="{{ shop.name | escape }}">
    <meta property="og:description" content="{{ meta_description | strip_html | escape }}">
    {%- if settings.social_image != blank -%}
      {%- assign og_url = settings.social_image | image_url: width: 1200 -%}
      {%- unless og_url contains 'http' -%}{%- assign og_url = og_url | prepend: 'https:' -%}{%- endunless -%}
      <meta property="og:image" content="{{ og_url }}">
    {%- endif -%}
    {% render 'theme-head' %}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    {% render 'logo-sprite' %}
    <a class="skip" href="#main">{{ 'general.skip_to_content' | t }}</a>
    <main id="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>

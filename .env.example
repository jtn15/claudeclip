# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# Claude model used to pick moments
CLIPENGINE_MODEL=claude-sonnet-4-6
# Whisper model size: tiny, base, small, medium, large-v3 (bigger = more accurate, slower)
WHISPER_MODEL=small
# WHISPER_DEVICE=auto          # auto | cpu | cuda
# WHISPER_COMPUTE_TYPE=auto    # e.g. int8 (CPU), float16 (GPU)
# CLIPENGINE_OUTPUT_DIR=output
# CLIPENGINE_MAX_VIDEO_HOURS=4

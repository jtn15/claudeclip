<div class="waitlist">
  <div class="waitlist-inner">
    {% render 'logo-lockup', class: 'logo-hero' %}
    <h1>{{ settings.tagline }}</h1>
    <p class="label muted">Doors open {{ settings.launch_label }}.</p>
    <div class="waitlist-form">
      {% render 'signup-form', form_id: 'waitlist', tag: 'waitlist', button: 'Join the waitlist' %}
    </div>
    <details class="owner-login">
      <summary class="label">Enter using password</summary>
      <div>
        {%- form 'storefront_password' -%}
          {{ form.errors | default_errors }}
          <label class="label" for="storefront-password">Password</label>
          <input id="storefront-password" type="password" name="password" autocomplete="current-password" required>
          <button class="btn" type="submit" style="margin-top: 0.75rem">Enter</button>
        {%- endform -%}
      </div>
    </details>
  </div>
</div>
<footer class="site-footer site-footer-slim">
  <div class="wrap footer-base" style="border: 0; margin: 0 auto; padding: 0 var(--gutter); justify-content: center; gap: 1.75rem">
    <p>Est. {{ settings.established }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Waitlist page"
}
{% endschema %}

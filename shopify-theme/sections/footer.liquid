<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        {% render 'logo-monogram', class: 'logo-mono' %}
        <p class="muted" style="margin-top: 1.25rem">{{ settings.tagline }}</p>
      </div>
      {%- for block in section.blocks -%}
        <div class="footer-col" {{ block.shopify_attributes }}>
          <h2>{{ block.settings.heading }}</h2>
          <ul>
            {%- for link in linklists[block.settings.menu].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
            {%- if block.settings.show_policies -%}
              {%- for policy in shop.policies -%}
                <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
              {%- endfor -%}
            {%- endif -%}
            {%- if block.settings.show_instagram -%}
              <li>
                {%- if settings.instagram_handle != blank -%}
                  <a href="https://www.instagram.com/{{ settings.instagram_handle | remove: '@' }}/" rel="noopener">Instagram</a>
                {%- else -%}
                  Instagram {% render 'todo', label: 'Instagram handle' %}
                {%- endif -%}
              </li>
            {%- endif -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
    <div class="footer-base">
      <p>&copy; {{ settings.established }} {{ shop.name }}. {% render 'returns-line' %} <a href="{{ routes.root_url }}pages/shipping-returns">Return policy</a></p>
      <p>Est. {{ settings.established }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "links",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Help" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" },
        { "type": "checkbox", "id": "show_policies", "label": "List Shopify policies (privacy, terms, refund, shipping)", "default": false },
        { "type": "checkbox", "id": "show_instagram", "label": "Show Instagram link", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "links", "settings": { "heading": "Shop", "menu": "main-menu" } },
        { "type": "links", "settings": { "heading": "Help", "menu": "footer" } },
        { "type": "links", "settings": { "heading": "Maison Rivault", "menu": "footer", "show_instagram": true } },
        { "type": "links", "settings": { "heading": "Legal", "show_policies": true } }
      ]
    }
  ]
}
{% endschema %}

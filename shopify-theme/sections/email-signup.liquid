<section id="waitlist">
  <div class="col">
    <h2>{{ section.settings.heading }}</h2>
    <p class="muted">{{ section.settings.text }}</p>
    {% render 'signup-form', form_id: section.id, tag: section.settings.tag, button: section.settings.button %}
  </div>
</section>

{% schema %}
{
  "name": "Email signup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Doors open mid-December." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Leave your email and we will write once when they do." },
    { "type": "text", "id": "button", "label": "Button label", "default": "Notify me" },
    { "type": "text", "id": "tag", "label": "Customer tag", "default": "waitlist", "info": "Added to the customer so you can filter your list." }
  ],
  "presets": [{ "name": "Email signup" }]
}
{% endschema %}

<section>
  <div class="wrap">
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.collection != blank -%}
        <a class="label" href="{{ section.settings.collection.url }}">View all</a>
      {%- endif -%}
    </div>
    {%- if section.settings.blurb != blank -%}
      <p class="muted" style="margin-bottom: 2rem">{{ section.settings.blurb }}</p>
    {%- endif -%}
    {%- if section.settings.collection != blank -%}
      <div class="grid">
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="muted">{% render 'todo', label: 'choose a collection for this section in the theme editor' %}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Signature" },
    { "type": "text", "id": "blurb", "label": "Short line under the heading" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Collection grid" }]
}
{% endschema %}
